# sound effect 00: pickup (original design)
name pickup
tempo 600
tpb 4
echo 0.5 0.2
inst bell wave=sine mix2=0.35 oct2=2 detune=4 a=0.002 d=0.25 s=0.0 r=0.2 gain=0.32 verb=0.35 delay=0.15
inst spark wave=pulse duty=0.125 a=0.002 d=0.05 s=0.0 r=0.06 gain=0.12 cutoff=7000 verb=0.2
n 0 bell 88 2 0.8
n 2 bell 95 6 1.0
n 2 spark 107 1 0.6
n 3 spark 112 1 0.4
length 8
