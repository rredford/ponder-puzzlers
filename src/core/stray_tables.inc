// Drawing Chip in a junk state overwrites part of the program (measured; spec doc 04 §4.4 "Display"). When an
// off-map write puts one of these values into slot 0's state byte, the original crashes this many ticks later
// (index 0: write on an even tick, 1: odd; -1 = harmless). Measured with at least one other object on screen.
static int8_t chipDrawDelay(uint8_t v, int odd) {
    if (v >= 0xD2 && v <= 0xE2) return 1;
    switch (v) {
    case 0xF4: return 1;
    case 0xF8: return 0;
    case 0xE8: return odd ? 2 : 1;
    case 0xEA: case 0xEC: case 0xF2: case 0xF7: case 0xFF: return odd ? 3 : 2;
    default: return -1;
    }
}
